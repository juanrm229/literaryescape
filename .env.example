# Postgres (Neon / Supabase / Railway / local)
DATABASE_URL=postgresql://pm:pm@localhost:5432/postmortem

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Magic link email via Resend (optional in dev: links are printed to the server log)
RESEND_API_KEY=
EMAIL_FROM=postmortem <kabar@yourdomain.com>

# Google sign-in (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails that can open /admin
ADMIN_EMAILS=you@example.com

# Testing only: pretend today is this date (YYYY-MM-DD). Ignored in production.
PM_TODAY=
